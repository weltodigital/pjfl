# Copy to .env.local for local development, and add the same values in
# Vercel under Settings > Environment Variables for the deployed site.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain verified in Resend.
# While pjfl.co.uk is still being verified, use: onboarding@resend.dev
CONTACT_FROM="PJFL Website <website@pjfl.co.uk>"
